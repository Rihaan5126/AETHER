# Copy to .env and adjust. Never commit .env.
# AETHER is a historical-simulation research tool: there are no brokerage
# credentials, and none should ever be added here.

# --- Postgres (Docker Compose) ---
POSTGRES_USER=aether
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aether

# --- API ---
AETHER_ENVIRONMENT=development
# When set, every POST requires the header X-API-Key. Required in production.
AETHER_API_KEY=
AETHER_CORS_ORIGINS=["http://localhost:3000"]
# Optional Yahoo Finance import (subject to Yahoo's terms; off by default).
AETHER_ENABLE_YAHOO=false
# Most jobs that may be queued or running at once (all clients together).
AETHER_MAX_PENDING_JOBS=5
# Process-pool size for one training job. Keep small on laptops.
AETHER_MAX_WORKERS_PER_JOB=1

# Running without Docker? Defaults use SQLite and the in-process job runner:
# AETHER_DATABASE_URL=sqlite:///./aether.db
# AETHER_JOB_BACKEND=inline

# --- Dashboard ---
# URL the browser uses to reach the API (baked in at build time).
PUBLIC_API_URL=http://localhost:8000
# Must match AETHER_API_KEY if one is set (local use only: it is visible to the browser).
NEXT_PUBLIC_API_KEY=

# --- Worker resource limits ---
WORKER_CPUS=2
WORKER_MEMORY=4g

# --- Build options ---
# CPU-only PyTorch by default. Point at https://pypi.org/simple for the CUDA build.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Image overrides (e.g. a registry mirror when Docker Hub rate-limits you).
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.13-slim
# NODE_IMAGE=mirror.gcr.io/library/node:22-alpine
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
# REDIS_IMAGE=mirror.gcr.io/library/redis:7-alpine
